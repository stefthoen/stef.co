---
import "normalize.css/normalize.css"
import "../styles/site.css"
import Cta from "../components/Cta.astro"
import Footer from "../components/Footer.astro"
import LanguageSwitch from "../components/LanguageSwitch.astro"
import { SITE_TITLE, TWITTER_HANDLE } from "../data/site"
import type { Lang } from "../data/ui"

interface Props {
  /** Page title; left out on the home page. */
  title?: string
  description?: string
  lang?: Lang
  /** Path of this page in the other language; adds the flag that switches. */
  alternate?: string
}

const { title, description, lang = "nl", alternate } = Astro.props

const fullTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE
const otherLang: Lang = lang === "nl" ? "en" : "nl"
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {alternate && (
      <>
        <link
          rel="alternate"
          hreflang={lang}
          href={new URL(Astro.url.pathname, Astro.site)}
        />
        <link
          rel="alternate"
          hreflang={otherLang}
          href={new URL(alternate, Astro.site)}
        />
      </>
    )}
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content={TWITTER_HANDLE} />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
  </head>
  <body>
    <div class="topbar">
      <Cta lang={lang} />
      {alternate && <LanguageSwitch to={otherLang} href={alternate} />}
    </div>
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

---
import { Picture } from "astro:assets"

interface Props {
  title: string
  /** The years of the work, as in "2022–2024". */
  period?: string
  /** What it was built with, as in "Laravel, Livewire, Filament". */
  tech?: string
  /** Leave out the link and the screenshot for a client that can't be named. */
  url?: string
  image?: ImageMetadata
}

const { title, period, tech, url, image } = Astro.props
---

<article class="case">
  <h3>{url ? <a href={url}>{title}</a> : title}</h3>
  {period && <p class="period">{period}</p>}
  {image && (
    <a class="screenshot" href={url} target="_blank" rel="noopener noreferrer">
      <Picture
        src={image}
        formats={["webp"]}
        widths={[418, image.width]}
        sizes="(max-width: 836px) 100vw, 836px"
        alt=""
      />
    </a>
  )}
  <div class="content">
    <slot />
  </div>
  {tech && <p class="tech">{tech}</p>}
</article>

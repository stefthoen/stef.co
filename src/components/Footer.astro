---
import Container from "./Container.astro"
import { UI, type Lang } from "../data/ui"

interface Props {
  lang: Lang
}

const t = UI[Astro.props.lang]
---

<footer class="footer">
  <Container>
    <div class="content">
      <div>
        <h2>{t.footerAddress}</h2>
        <ul>
          <li>4 Frétoy</li>
          <li>71550 Cussy-en-Morvan</li>
          <li>{t.footerCountry}</li>
        </ul>
      </div>
      <div>
        <h2>{t.footerContact}</h2>
        <ul>
          <li>
            <a
              href="https://twitter.com/stefthoen"
              target="_blank"
              rel="noopener noreferrer"
            >
              Twitter
            </a>
          </li>
          <li>
            <a
              href="https://www.instagram.com/scnthoen/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram
            </a>
          </li>
          <li>
            <a href="mailto:hi@stef.co">hi@stef.co</a>
          </li>
        </ul>
      </div>
      <div>
        <h2>{t.footerAdministration}</h2>
        <ul>
          <li>Siret: 81448255000013</li>
          <li>Bank: NL47 ASNB 0708 3314 67</li>
          <li>TVA: FR08814482550</li>
        </ul>
      </div>
    </div>
    <footer class="copyright">
      <a href="http://creativecommons.org/licenses/by-nc-nd/3.0/">
        {t.footerLicense}
      </a>{" "}
      | <a href="https://github.com/stefthoen/stef.co">{t.footerSource}</a>
    </footer>
  </Container>
</footer>

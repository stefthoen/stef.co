---
interface Props {
  author: string
  jobTitle: string
  company: string
  companyURL: string
}

const { author, jobTitle, company, companyURL } = Astro.props
---

<figure class="testimonial">
  <blockquote>
    <slot />
  </blockquote>
  <figcaption>
    —{author},{" "}
    <cite>
      {jobTitle} @ <a href={companyURL}>{company}</a>
    </cite>
  </figcaption>
</figure>

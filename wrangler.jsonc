// Cloudflare Worker: the build in dist/ is served as static assets, and
// worker/index.js runs first to redirect www and plain http.
{
  "name": "stef-co",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  // Zone routes, so each name needs a proxied DNS record in Cloudflare.
  // worker/index.js sends www to the main domain.
  "routes": [
    { "pattern": "stef.co/*", "zone_name": "stef.co" },
    { "pattern": "www.stef.co/*", "zone_name": "stef.co" },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
}
